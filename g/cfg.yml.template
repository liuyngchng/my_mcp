# MCP 自然语言查询客户端配置
# 部署时复制为 cfg.yml 并根据实际环境修改：
#   cp cfg.yml.template cfg.yml

server:
  port: 19002
  debug: true

# MCP 服务器连接配置
mcp:
  # verify_ssl: true  → verify HTTPS cert
  # verify_ssl: false → skip cert verification (self-signed / internal)
  verify_ssl: false
  # enable_proxy: true  → use HTTP_PROXY/HTTPS_PROXY env vars
  # enable_proxy: false → connect directly, ignore env vars
  enable_proxy: true
  # auth token (code auto-prepends "Bearer " for Authorization header)
  auth_token: ""

# LLM 配置（OpenAI 兼容接口）
llm:
  api_uri: "https://api.openai.com/v1"
  api_key: ""
  model_name: "gpt-4o"
  # verify_ssl: true  → verify HTTPS cert
  # verify_ssl: false → skip cert verification (self-signed / internal)
  verify_ssl: false
  # enable_proxy: true  → use HTTP_PROXY/HTTPS_PROXY env vars
  # enable_proxy: false → connect directly, ignore env vars
  enable_proxy: false